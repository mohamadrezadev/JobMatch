# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/jobmatch"

# JWT
JWT_SECRET="replace-with-your-own-random-secret-min-32-chars"
JWT_EXPIRES_IN="1h"
REFRESH_TOKEN_SECRET="replace-with-a-different-random-secret-min-32-chars"
REFRESH_TOKEN_EXPIRES_IN="7d"

# OpenAI
# Obtain your own router key from the team; never commit real credentials.
OPENAI_API_KEY=
OPENAI_MODEL="agents"
OPENAI_BASE_URL=http://185.204.170.189:20128/v1

# App
PORT=3100
NODE_ENV=development

# CORS
CORS_ORIGIN="http://localhost:3001"

# Iranian job discovery (server only)
NINEROUTER_BASE_URL=http://185.204.170.189:20128/v1
NINEROUTER_API_KEY=
# Route web searches through the configured 9Router search combo.
NINEROUTER_SEARCH_MODEL=search-combo
NINEROUTER_FETCH_MODEL=tinyfish
# The shared router's TinyFish policy was verified. Re-verify before changing providers.
NINEROUTER_FETCH_POLICY_VERIFIED=true
JOB_DISCOVERY_ALLOWED_DOMAINS=jobvision.ir,jobinja.ir,irantalent.com,e-estekhdam.com
JOB_DISCOVERY_SEARCH_TIMEOUT_MS=15000
JOB_DISCOVERY_FETCH_TIMEOUT_MS=15000
JOB_DISCOVERY_TOTAL_TIMEOUT_MS=60000
