# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/jobmatch"

# JWT
JWT_SECRET="replace-with-your-own-random-secret-min-32-chars"
JWT_EXPIRES_IN="1h"
REFRESH_TOKEN_SECRET="replace-with-a-different-random-secret-min-32-chars"
REFRESH_TOKEN_EXPIRES_IN="7d"

# OpenAI
# Obtain your own router key from the team; never commit real credentials.
OPENAI_API_KEY=
OPENAI_MODEL="agents"
# Optional dedicated planner model; falls back to OPENAI_MODEL.
AGENT_PLANNER_MODEL=
# Optional message understanding model; runs before the planner.
AGENT_INTENT_MODEL=
OPENAI_BASE_URL=http://185.204.170.189:20128/v1

# App
PORT=3100
NODE_ENV=development

# CORS
CORS_ORIGIN="http://localhost:3001"

# Iranian job discovery (server only)
NINEROUTER_BASE_URL=http://185.204.170.189:20128/v1
NINEROUTER_API_KEY=
# Route web searches through the configured 9Router search combo.
NINEROUTER_SEARCH_MODEL=search-combo
NINEROUTER_FETCH_MODEL=tinyfish
# The shared router's TinyFish policy was verified. Re-verify before changing providers.
NINEROUTER_FETCH_POLICY_VERIFIED=true
# The shared webfetch account (tinyfish) locks out for 19-30s once it sees
# concurrent requests; keep this low (1 = fully serialized) to avoid tripping it.
NINEROUTER_FETCH_CONCURRENCY=1
JOB_DISCOVERY_ALLOWED_DOMAINS=jobvision.ir,jobinja.ir,irantalent.com,e-estekhdam.com
JOB_DISCOVERY_SEARCH_TIMEOUT_MS=20000
JOB_DISCOVERY_FETCH_TIMEOUT_MS=20000
JOB_DISCOVERY_EXTRACTION_TIMEOUT_MS=8000
# Optional dedicated extraction model; falls back to OPENAI_MODEL. Useful when
# the shared OPENAI_MODEL combo/alias is slow or unreliable for this one step.
JOB_DISCOVERY_EXTRACTION_MODEL=
# Serialized fetches take longer wall-clock time; this budget has more room
# than JOB_DISCOVERY_FETCH_TIMEOUT_MS alone to compensate.
JOB_DISCOVERY_TOTAL_TIMEOUT_MS=90000

# V1M job quality gate (reuses the 9Router host and key above; no separate
# credential is introduced)
V1M_ENABLED=false
V1M_MODELS=openrouter/typesafe/jev-1.13,oc/jev-1.13-free
V1M_TIMEOUT_MS=1500
V1M_JOB_THRESHOLD=0.70
V1M_CLOSED_THRESHOLD=0.70
V1M_SPAM_THRESHOLD=0.70
V1M_MAX_CONTENT_CHARS=30000
