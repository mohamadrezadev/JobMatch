# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/jobmatch"

# JWT
JWT_SECRET="your-super-secret-jwt-key-min-32-chars"
JWT_EXPIRES_IN="1h"
REFRESH_TOKEN_SECRET="your-super-secret-refresh-token-key-min-32-chars"
REFRESH_TOKEN_EXPIRES_IN="7d"

# OpenAI
OPENAI_API_KEY="sk-your-openai-api-key"
OPENAI_MODEL="gpt-4o-mini"
# Optional OpenAI-compatible router URL, including /v1. For a configured 9Router combo use OPENAI_MODEL="agents".
OPENAI_BASE_URL=

# App
PORT=3000
NODE_ENV=development

# CORS
CORS_ORIGIN="http://localhost:3001"

# Iranian job discovery (server only)
NINEROUTER_BASE_URL=http://127.0.0.1:20128
NINEROUTER_API_KEY=
NINEROUTER_SEARCH_MODEL=
# For the supplied router's configured search combo, use NINEROUTER_SEARCH_MODEL=search-combo.
NINEROUTER_FETCH_MODEL=
# For a router with TinyFish configured, use NINEROUTER_FETCH_MODEL=tinyfish (Markdown).
# Enable only after provider redirect/DNS controls or controlled egress are verified.
NINEROUTER_FETCH_POLICY_VERIFIED=false
JOB_DISCOVERY_ALLOWED_DOMAINS=jobvision.ir,jobinja.ir,irantalent.com,e-estekhdam.com
JOB_DISCOVERY_SEARCH_TIMEOUT_MS=15000
JOB_DISCOVERY_FETCH_TIMEOUT_MS=15000
JOB_DISCOVERY_TOTAL_TIMEOUT_MS=60000
