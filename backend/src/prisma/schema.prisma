generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Local Dev (SQLite — remove when using PostgreSQL) ───────────────────────
// datasource db {
//   provider = "sqlite"
//   url      = "file:./dev.sqlite"
// }

enum ExperienceLevel {
  Junior
  Mid
  Senior
}

enum WorkType {
  Remote
  OnSite
  Hybrid
}

enum SkillCategory {
  Programming
  Framework
  Tool
  Soft
}

enum SkillLevel {
  Beginner
  Intermediate
  Advanced
}

enum FeedbackRating {
  Interested
  NotInterested
}

enum FeedbackReason {
  Salary
  Location
  Technology
  ExperienceLevel
  JobType
  NotInterestedInCompany
  Other
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  firstName String
  lastName  String
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  profile         Profile?
  userSkills      UserSkill[]
  resumes         Resume[]
  resumeBase      ResumeBase?
  resumeProposals ResumeProposal[]
  feedbacks       JobFeedback[]
  conversations   Conversation[]
  discoveryRuns   JobDiscoveryRun[]
  chatRuns        ChatRun[]
  analyticsEvents AnalyticsEvent[]

  @@map("users")
}

model Profile {
  userId            String   @id
  title             String?
  bio               String?
  location          String?
  desiredSalary     Float?
  experienceYears   Float?
  experienceLevel   ExperienceLevel?
  workType          WorkType?
  socialLinks       Json?
  resumeFacts       String[] @default([])
  isProfileComplete Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model Skill {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  category    SkillCategory
  createdAt   DateTime @default(now())

  userSkills UserSkill[]

  @@map("skills")
}

model UserSkill {
  id                String     @id @default(uuid())
  userId            String
  skillId           String
  level             SkillLevel @default(Intermediate)
  yearsOfExperience Float?
  createdAt         DateTime   @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  skill   Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)

  @@unique([userId, skillId])
  @@map("user_skills")
}

model Job {
  id              String    @id @default(uuid())
  title           String
  company         String
  location        String?
  workType        WorkType?
  experienceLevel String?
  salaryMin       Float?
  salaryMax       Float?
  description     String?
  requiredSkills  Json
  preferredSkills Json?
  source          String
  sourceUrl       String?   @unique
  discoveryKey    String?   @unique
  currency        String?
  salaryPeriod    String?
  postedAt        DateTime?
  discoveredAt    DateTime  @default(now())
  lastSeenAt      DateTime  @default(now())
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  resumes     Resume[]
  resumeProposals ResumeProposal[]
  feedbacks   JobFeedback[]

  @@index([source])
  @@index([postedAt])
  @@map("jobs")
}

model Resume {
  id        String   @id @default(uuid())
  userId    String
  jobId     String
  content   Json
  version   Int      @default(1)
  pdfPath   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@unique([userId, jobId])
  @@map("resumes")
}

model ResumeBase {
  id        String @id @default(uuid())
  userId    String @unique
  content   Json
  version   Int @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@map("resume_bases")
}

model ResumeProposal {
  id             String @id @default(uuid())
  userId         String
  jobId          String
  content        Json
  sourceSnapshot Json
  baseVersion    Int
  status         String @default("PROPOSED")
  createdAt      DateTime @default(now())
  acceptedAt     DateTime?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job Job @relation(fields: [jobId], references: [id], onDelete: Cascade)
  @@index([userId, jobId, createdAt])
  @@map("resume_proposals")
}

model JobFeedback {
  id        String            @id @default(uuid())
  userId    String
  jobId     String
  rating    FeedbackRating
  reason    FeedbackReason?
  notes     String?
  createdAt DateTime          @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  job  Job  @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([jobId])
  @@map("job_feedbacks")
}

model Conversation {
  id        String   @id @default(uuid())
  userId    String
  status    String   @default("Active")
  context   Json
  version   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  ConversationMessage[]
  chatRuns  ChatRun[]

  @@index([userId, updatedAt])
  @@map("conversations")
}

model ConversationMessage {
  id             String   @id @default(uuid())
  conversationId String
  role           String
  content        String
  metadata       Json?
  sequence       Int
  createdAt      DateTime @default(now())
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, sequence])
  @@map("conversation_messages")
}

model GuestChatSession {
  tokenHash      String   @id
  context        Json
  messages       Json
  turns          Int      @default(0)
  claimedBy      String?
  conversationId String?
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([expiresAt])
  @@map("guest_chat_sessions")
}

model JobDiscoveryRun {
  id             String   @id @default(uuid())
  userId         String
  conversationId String
  contextVersion Int
  searchIntent   Json
  status         String
  sourceReports  Json
  jobIds         Json
  resultCount    Int      @default(0)
  startedAt      DateTime @default(now())
  completedAt    DateTime?
  errorCode      String?
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([conversationId, contextVersion])
  @@index([userId, startedAt])
  @@map("job_discovery_runs")
}

model ChatRun {
  id                 String   @id @default(uuid())
  userId             String
  requestId          String
  conversationId     String?
  retryOf             String?
  message             String
  userMessageId       String?
  assistantMessageId  String?
  contextVersion      Int?
  status              String   @default("QUEUED")
  eventSequence       Int      @default(0)
  errorCode           String?
  startedAt           DateTime @default(now())
  completedAt         DateTime?
  user                User @relation(fields: [userId], references: [id], onDelete: Cascade)
  conversation        Conversation? @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  events              ChatRunEvent[]

  @@unique([userId, requestId])
  @@index([conversationId, startedAt])
  @@map("chat_runs")
}

model ChatRunEvent {
  id        String @id @default(uuid())
  runId     String
  sequence  Int
  type      String
  data      Json
  createdAt DateTime @default(now())
  run       ChatRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@unique([runId, sequence])
  @@map("chat_run_events")
}

model AnalyticsEvent {
  id         String   @id @default(uuid())
  userId     String
  name       String
  resourceId String?
  createdAt  DateTime @default(now())
  user       User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([name, createdAt])
  @@map("analytics_events")
}
